# TERRA HOP - Production Environment Variables
# Copy this file to .env on your cPanel / VPS server.

# Secret Admin Dashboard Paths
ADMIN_PATH=k7q2-vault-9xm4
ADMIN_LOGIN_PATH=k7q2-vault-9xm4

# Admin Authentication Credentials
ADMIN_EMAIL=admin@terrahop.com
ADMIN_PASSWORD=admin123

# Cryptographic Session & Vault Encryption Secret (HMAC-SHA256 & AES-256-GCM)
SESSION_SECRET=terra-hop-secure-jwt-secret-key-2026-v1

# Promo Codes & Discounts (Format: CODE:DISCOUNT_PERCENT,CODE:DISCOUNT_PERCENT)
PROMO_CODES=TERRA10:10,VIP20:20,WELCOME50:50,DROP01:15

# Node Environment
NODE_ENV=production
